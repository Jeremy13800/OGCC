{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["vite.config.ts", "vite.content.config.ts", "vite.shared.ts", "vitest.config.ts", "scripts/**/*.mjs", "eslint.config.js"]
}
